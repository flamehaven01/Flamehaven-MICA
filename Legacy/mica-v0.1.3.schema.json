{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flamehaven.ai/schemas/mica-v0.1.3.schema.json",
  "title": "Flamehaven MICA v0.1.3",
  "description": "Memory Invocation & Context Archive for AI -- Consolidated schema (v0.1.1 base + v0.1.2 validation tightening + v0.1.3 structural consistency)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "design_invariants",
    "source_kinds",
    "canonical_models",
    "invoke_role_semantics",
    "normalization_policy",
    "collector_pipeline",
    "scoring_policy",
    "dedup_policy",
    "budget_policy",
    "mapping_rules",
    "handoff_policy",
    "artifact_handle_policy",
    "error_policy",
    "ledger_policy",
    "cache_policy",
    "schema_migration",
    "observability",
    "acceptance_criteria",
    "non_goals"
  ],
  "properties": {
    "project":                { "$ref": "#/$defs/project" },
    "design_invariants":      { "type": "array", "items": { "type": "string" } },
    "scope":                  { "$ref": "#/$defs/scope" },
    "source_kinds":           { "type": "object", "additionalProperties": { "$ref": "#/$defs/sourceKind" } },
    "canonical_models":       { "$ref": "#/$defs/canonicalModels" },
    "invoke_role_semantics":  { "$ref": "#/$defs/invokeRoleSemantics" },
    "normalization_policy":   { "$ref": "#/$defs/normalizationPolicy" },
    "collector_pipeline":     { "$ref": "#/$defs/collectorPipeline" },
    "scoring_policy":         { "$ref": "#/$defs/scoringPolicy" },
    "dedup_policy":           { "$ref": "#/$defs/dedupPolicy" },
    "budget_policy":          { "$ref": "#/$defs/budgetPolicy" },
    "mapping_rules":          { "type": "array", "items": { "$ref": "#/$defs/mappingRule" } },
    "handoff_policy":         { "$ref": "#/$defs/handoffPolicy" },
    "artifact_handle_policy": { "$ref": "#/$defs/artifactHandlePolicy" },
    "error_policy":           { "$ref": "#/$defs/errorPolicy" },
    "ledger_policy":          { "$ref": "#/$defs/ledgerPolicy" },
    "cache_policy":           { "$ref": "#/$defs/cachePolicy" },
    "schema_migration":       { "$ref": "#/$defs/schemaMigration" },
    "observability":          { "$ref": "#/$defs/observability" },
    "acceptance_criteria":    { "type": "array", "items": { "type": "string" } },
    "non_goals":              { "type": "array", "items": { "type": "string" } },
    "examples":               { "$ref": "#/$defs/examples" }
  },

  "$defs": {

    "stringList": {
      "type": "array",
      "items": { "type": "string" }
    },

    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "full_name", "version", "status", "purpose", "canonical_statement"],
      "properties": {
        "name":                 { "type": "string" },
        "full_name":            { "type": "string" },
        "version":              { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "status":               { "type": "string" },
        "lineage":              { "$ref": "#/$defs/stringList" },
        "purpose":              { "type": "string" },
        "canonical_statement":  { "type": "string" }
      }
    },

    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": { "$ref": "#/$defs/stringList" },
        "exclude": { "$ref": "#/$defs/stringList" }
      }
    },

    "sourceKind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "default_tier", "trust_class"],
      "properties": {
        "description":  { "type": "string" },
        "default_tier": { "type": "string", "enum": ["session", "memory", "artifact_ref", "working"] },
        "trust_class":  { "type": "string", "enum": ["canonical", "distilled", "raw", "symbolic"] }
      }
    },

    "canonicalModels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance",
        "context_item",
        "context_budget",
        "context_ledger_entry",
        "working_context",
        "compiled_view"
      ],
      "properties": {
        "provenance":           { "$ref": "#/$defs/modelShape" },
        "context_item":         { "$ref": "#/$defs/modelShape" },
        "context_budget":       { "$ref": "#/$defs/modelShape" },
        "context_ledger_entry": { "$ref": "#/$defs/modelShape" },
        "working_context":      { "$ref": "#/$defs/modelShape" },
        "compiled_view":        { "$ref": "#/$defs/modelShape" }
      }
    },

    "modelShape": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "required":                 { "$ref": "#/$defs/stringList" },
        "optional":                 { "$ref": "#/$defs/stringList" },
        "fields":                   { "type": "object", "additionalProperties": true },
        "memory_exclusion_scope":   { "type": "string" },
        "budget_defaults":          { "type": "object", "additionalProperties": true }
      }
    },

    "invokeRoleSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_type", "note", "roles"],
      "properties": {
        "rule_type": { "type": "string" },
        "note":      { "type": "string" },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["none", "hint", "bridge", "anchor"],
          "properties": {
            "none":   { "$ref": "#/$defs/invokeRoleRule" },
            "hint":   { "$ref": "#/$defs/invokeRoleRule" },
            "bridge": { "$ref": "#/$defs/invokeRoleRule" },
            "anchor": { "$ref": "#/$defs/invokeRoleRule" }
          }
        }
      }
    },

    "invokeRoleRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meaning", "score_bonus", "pin_behavior", "compile_behavior", "eviction_priority"],
      "properties": {
        "meaning":            { "type": "string" },
        "score_bonus":        { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "pin_behavior":       { "type": "string" },
        "compile_behavior":   { "type": "string" },
        "eviction_priority":  { "type": "integer", "minimum": 0 }
      }
    },

    "normalizationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preserve_verbatim_where_possible",
        "keep_category_order",
        "unknown_date_token",
        "canonical_export_dedup",
        "whitespace_normalization",
        "case_normalization_for_hashing",
        "structural_projection_is_canonical"
      ],
      "properties": {
        "preserve_verbatim_where_possible": { "type": "boolean" },
        "keep_category_order":              { "$ref": "#/$defs/stringList" },
        "unknown_date_token":               { "type": "string" },
        "canonical_export_dedup":           { "type": "boolean" },
        "whitespace_normalization":         { "type": "string" },
        "case_normalization_for_hashing":   { "type": "boolean" },
        "structural_projection_is_canonical": { "type": "boolean" },
        "notes":                            { "$ref": "#/$defs/stringList" }
      }
    },

    "collectorPipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "steps":            { "$ref": "#/$defs/stringList" },
        "source_priority":  { "$ref": "#/$defs/stringList" }
      }
    },

    "scoringPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_range",
        "one_shot_invoke_bonus",
        "one_shot_rule_text",
        "function",
        "components",
        "tie_breakers"
      ],
      "properties": {
        "output_range":           { "type": "string" },
        "one_shot_invoke_bonus":  { "type": "boolean", "const": true },
        "one_shot_rule_text":     { "type": "string" },
        "function":               { "type": "string" },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sim", "recency", "invoke", "trust", "continuity"],
          "properties": {
            "sim":        { "$ref": "#/$defs/simComponent" },
            "recency":    { "$ref": "#/$defs/recencyComponent" },
            "invoke":     { "$ref": "#/$defs/invokeComponent" },
            "trust":      { "$ref": "#/$defs/trustComponent" },
            "continuity": { "$ref": "#/$defs/continuityComponent" }
          }
        },
        "tie_breakers": { "$ref": "#/$defs/stringList" }
      }
    },

    "simComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "preferred_metric", "fallback_metric", "normalization"],
      "properties": {
        "description":      { "type": "string" },
        "preferred_metric":  { "type": "string" },
        "fallback_metric":   { "type": "string" },
        "normalization":     { "type": "string" }
      }
    },

    "recencyComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "function", "unknown_date_recency"],
      "properties": {
        "description": { "type": "string" },
        "function":    { "type": "string" },
        "unknown_date_recency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "value", "rationale"],
          "properties": {
            "mode":      { "type": "string", "enum": ["fixed"] },
            "value":     { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "rationale": { "type": "string" }
          }
        }
      }
    },

    "invokeComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "mapping"],
      "properties": {
        "description": { "type": "string" },
        "mapping": {
          "type": "object",
          "additionalProperties": false,
          "required": ["none", "hint", "bridge", "anchor"],
          "properties": {
            "none":   { "type": "number" },
            "hint":   { "type": "number" },
            "bridge": { "type": "number" },
            "anchor": { "type": "number" }
          }
        }
      }
    },

    "trustComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "mapping", "normalization"],
      "properties": {
        "description": { "type": "string" },
        "mapping": {
          "type": "object",
          "additionalProperties": false,
          "required": ["canonical", "distilled", "raw", "symbolic"],
          "properties": {
            "canonical": { "type": "number" },
            "distilled": { "type": "number" },
            "raw":       { "type": "number" },
            "symbolic":  { "type": "number" }
          }
        },
        "normalization": { "type": "string" }
      }
    },

    "continuityComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "function"],
      "properties": {
        "description": { "type": "string" },
        "function":    { "type": "string" }
      }
    },

    "dedupPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compile_time_dedup",
        "exact_within_tier",
        "semantic_cross_tier",
        "fidelity_order",
        "preserve_rules"
      ],
      "properties": {
        "compile_time_dedup": { "type": "boolean" },
        "exact_within_tier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "key"],
          "properties": {
            "enabled": { "type": "boolean" },
            "key":     { "type": "string" }
          }
        },
        "semantic_cross_tier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "threshold", "action"],
          "properties": {
            "enabled":   { "type": "boolean" },
            "threshold": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "action":    { "type": "string" }
          }
        },
        "fidelity_order": {
          "type": "array",
          "items": { "type": "string", "enum": ["canonical", "distilled", "raw", "symbolic"] },
          "minItems": 4,
          "maxItems": 4
        },
        "preserve_rules": { "$ref": "#/$defs/stringList" }
      }
    },

    "evictionPhase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "order":       { "$ref": "#/$defs/stringList" },
        "action":      { "type": "string" },
        "guard":       { "type": "string" }
      }
    },

    "budgetPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_tokens",
        "estimation_method",
        "overflow_strategy",
        "anchor_cap",
        "tier_priority",
        "eviction_strategy",
        "failure_condition"
      ],
      "properties": {
        "max_tokens":         { "type": "integer", "minimum": 1 },
        "estimation_method":  { "type": "string" },
        "overflow_strategy":  { "type": "string" },
        "anchor_cap":         { "type": "integer", "minimum": 0 },
        "tier_priority":      { "$ref": "#/$defs/stringList" },
        "eviction_strategy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["phase_1", "phase_2", "phase_3", "phase_4", "phase_5"],
          "properties": {
            "phase_1": { "$ref": "#/$defs/evictionPhase" },
            "phase_2": { "$ref": "#/$defs/evictionPhase" },
            "phase_3": { "$ref": "#/$defs/evictionPhase" },
            "phase_4": { "$ref": "#/$defs/evictionPhase" },
            "phase_5": { "$ref": "#/$defs/evictionPhase" }
          }
        },
        "failure_condition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["if_budget_still_exceeded"],
          "properties": {
            "if_budget_still_exceeded": { "type": "string" }
          }
        }
      }
    },

    "mappingTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "trust_class"],
      "properties": {
        "tier":         { "type": "string", "enum": ["session", "memory", "artifact_ref"] },
        "invoke_role":  { "type": "string", "enum": ["none", "hint", "bridge", "anchor"] },
        "trust_class":  { "type": "string", "enum": ["canonical", "distilled", "raw", "symbolic"] },
        "sensitivity":  { "type": "string", "enum": ["low", "medium", "high"] },
        "labels":       { "type": "array", "items": { "type": "string" } },
        "note":         { "type": "string" }
      }
    },

    "mappingRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "match", "to_context_item"],
      "properties": {
        "source":           { "type": "string" },
        "match":            { "type": "string" },
        "to_context_item":  { "$ref": "#/$defs/mappingTarget" }
      }
    },

    "handoffPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_targets",
        "max_context_depth",
        "allow_memory",
        "allow_artifact_refs",
        "require_provenance",
        "redact",
        "deny_patterns",
        "memory_scope_rule",
        "enforcement"
      ],
      "properties": {
        "allowed_targets":    { "type": "array", "items": { "type": "string", "enum": ["modal_router", "fusion_oracle"] } },
        "max_context_depth":  { "type": "integer", "minimum": 0 },
        "allow_memory":       { "type": "boolean" },
        "allow_artifact_refs": { "type": "boolean" },
        "require_provenance": { "type": "boolean" },
        "redact":             { "$ref": "#/$defs/stringList" },
        "deny_patterns":      { "$ref": "#/$defs/stringList" },
        "memory_scope_rule":  { "type": "string" },
        "enforcement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prefilter", "target_compile", "output"],
          "properties": {
            "prefilter":       { "$ref": "#/$defs/stringList" },
            "target_compile":  { "$ref": "#/$defs/stringList" },
            "output": {
              "type": "object",
              "additionalProperties": false,
              "required": ["view_hash", "degraded_flag"],
              "properties": {
                "view_hash":     { "type": "string" },
                "degraded_flag": { "type": "boolean" }
              }
            }
          }
        }
      }
    },

    "artifactHandlePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signed_handles",
        "signing_algorithm",
        "expiry_required",
        "default_ttl_seconds",
        "inline_small_artifacts",
        "signing_triggers",
        "handle_gap_policy",
        "access_audit_required"
      ],
      "properties": {
        "signed_handles":     { "type": "boolean", "const": true },
        "signing_algorithm":  { "type": "string", "enum": ["ed25519"] },
        "expiry_required":    { "type": "boolean", "const": true },
        "default_ttl_seconds": { "type": "integer", "minimum": 1 },
        "inline_small_artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "max_bytes"],
          "properties": {
            "enabled":    { "type": "boolean" },
            "max_bytes":  { "type": "integer", "minimum": 1 }
          }
        },
        "signing_triggers":     { "type": "array", "items": { "type": "string" } },
        "handle_gap_policy":    { "type": "string" },
        "access_audit_required": { "type": "boolean" }
      }
    },

    "errorRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "severity"],
      "properties": {
        "action":   { "type": "string" },
        "severity": { "type": "string", "enum": ["warning", "error", "critical"] }
      }
    },

    "errorPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parse_failure",
        "provenance_resolution_failure",
        "source_hash_mismatch",
        "dedup_failure",
        "scoring_failure",
        "budget_compile_failure",
        "ledger_commit_failure",
        "target_policy_violation"
      ],
      "properties": {
        "parse_failure":                  { "$ref": "#/$defs/errorRule" },
        "provenance_resolution_failure":  { "$ref": "#/$defs/errorRule" },
        "source_hash_mismatch":           { "$ref": "#/$defs/errorRule" },
        "dedup_failure":                  { "$ref": "#/$defs/errorRule" },
        "scoring_failure":                { "$ref": "#/$defs/errorRule" },
        "budget_compile_failure":         { "$ref": "#/$defs/errorRule" },
        "ledger_commit_failure":          { "$ref": "#/$defs/errorRule" },
        "target_policy_violation":        { "$ref": "#/$defs/errorRule" }
      }
    },

    "ledgerPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_digest_only", "hash_chain", "payload_fields", "context_hash_formula", "audit_chain"],
      "properties": {
        "content_digest_only":  { "type": "boolean", "const": true },
        "hash_chain":           { "type": "boolean", "const": true },
        "payload_fields":       { "$ref": "#/$defs/stringList" },
        "context_hash_formula": { "type": "string" },
        "audit_chain":          { "$ref": "#/$defs/stringList" }
      }
    },

    "cachePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_formula", "fail_safe", "note"],
      "properties": {
        "key_formula": { "type": "string" },
        "fail_safe":   { "type": "string" },
        "note":        { "type": "string" }
      }
    },

    "schemaMigration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["versioning", "compatibility_rules", "migration_strategy", "reproducibility_gate"],
      "properties": {
        "versioning": { "type": "string", "enum": ["semver"] },
        "compatibility_rules": {
          "type": "object",
          "additionalProperties": false,
          "required": ["patch", "minor", "major"],
          "properties": {
            "patch": { "type": "string" },
            "minor": { "type": "string" },
            "major": { "type": "string" }
          }
        },
        "migration_strategy":   { "$ref": "#/$defs/stringList" },
        "reproducibility_gate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required_match_rate", "sample_scope"],
          "properties": {
            "required_match_rate": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "sample_scope":        { "type": "string" }
          }
        }
      }
    },

    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics", "slo_hints"],
      "properties": {
        "metrics":   { "$ref": "#/$defs/stringList" },
        "slo_hints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "p95_context_compile_ms",
            "p99_context_compile_ms",
            "budget_failure_rate_max",
            "degraded_rate_warn",
            "degraded_rate_critical",
            "handoff_leak_target",
            "audit_link_integrity_target"
          ],
          "properties": {
            "p95_context_compile_ms":     { "type": "integer", "minimum": 1, "description": "Must be <= p99_context_compile_ms" },
            "p99_context_compile_ms":     { "type": "integer", "minimum": 1, "description": "Must be >= p95_context_compile_ms" },
            "budget_failure_rate_max":    { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "degraded_rate_warn":         { "type": "number", "minimum": 0.0, "maximum": 1.0, "description": "Must be < degraded_rate_critical" },
            "degraded_rate_critical":     { "type": "number", "minimum": 0.0, "maximum": 1.0, "description": "Must be > degraded_rate_warn" },
            "handoff_leak_target":        { "type": "integer", "minimum": 0 },
            "audit_link_integrity_target": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
          }
        }
      }
    },

    "examples": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance_uris",
        "compiled_view_example",
        "dedup_example",
        "unknown_date_recency_example"
      ],
      "properties": {
        "provenance_uris": {
          "type": "array",
          "items": { "type": "string" }
        },
        "compiled_view_example": {
          "type": "object",
          "additionalProperties": true
        },
        "dedup_example": {
          "type": "object",
          "additionalProperties": true
        },
        "unknown_date_recency_example": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_date", "applied_recency", "reason"],
          "properties": {
            "input_date":       { "type": "string" },
            "applied_recency":  { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "reason":           { "type": "string" }
          }
        }
      }
    }
  }
}
