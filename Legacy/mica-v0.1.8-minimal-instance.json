{
  "mica_schema_version": "0.1.8.1",
  "project": {
    "name": "example-service",
    "full_name": "Example Service",
    "version": "1.0.0",
    "status": "active",
    "purpose": "Demonstrate minimum viable MICA archive structure",
    "canonical_statement": "Example Service is a minimal MICA archive demonstrating the smallest valid v0.1.8.1 instance."
  },
  "design_invariants": [
    {
      "id": "DI-001",
      "label": "no-external-deps",
      "statement": "No external runtime dependencies. Use stdlib only.",
      "severity": "critical"
    },
    {
      "id": "DI-002",
      "label": "ascii-source",
      "statement": "All source files must be ASCII-only.",
      "severity": "high"
    }
  ],
  "provenance_registry": [
    {
      "uri": "README.md",
      "sha256": "a665a45920422f9d417e4867efdc4fb8a04a1f3fff1fa07e998e86f7f7a27ae3",
      "kind": "file",
      "created_at": "2026-01-01T00:00:00Z",
      "trust_class": "canonical",
      "note": "Primary protocol document"
    }
  ],
  "invocation_protocol": {
    "primary_pattern": "readme_protocol",
    "loading_order": ["memory/example-service.mica.json"],
    "readme_section_heading": "## [AI Session Protocol]",
    "self_test_runtime": "readme_protocol_ai_session"
  },
  "session_report_format": {
    "trigger": "session_start",
    "required_fields": ["gate", "active_invariants", "track"],
    "gate_block_on": [],
    "format_template": "[SESSION READY]\nGate: {gate}\nInvariants: {active_invariants}\nTrack: {track}"
  },
  "drift_response_policy": {
    "on_hash_mismatch": "warn_continue",
    "on_file_missing": "warn_block",
    "reminder_after_change": true
  },
  "self_test_policy": {
    "enabled": true,
    "run_on": ["session_start"],
    "on_failure": "warn_continue",
    "checks": [
      {
        "id": "ST-001",
        "description": "All provenance_registry SHA256 values are valid hex",
        "check_type": "provenance_sha256_format",
        "expression": "all($.provenance_registry[*].sha256, match(x, '^[A-Fa-f0-9]{64}$'))",
        "severity": "error",
        "on_fail": "report_and_continue"
      },
      {
        "id": "ST-002",
        "description": "invocation_protocol.primary_pattern is declared",
        "check_type": "invocation_pattern_present",
        "expression": "exists($.invocation_protocol.primary_pattern)",
        "severity": "error",
        "on_fail": "require_acknowledgment"
      }
    ]
  },
  "scope": {
    "include": ["src/", "README.md"],
    "exclude": ["__pycache__/", "*.pyc"]
  },
  "source_kinds": {
    "source_code": {
      "description": "Application source files",
      "default_tier": "memory",
      "trust_class": "canonical"
    },
    "project_docs": {
      "description": "README and documentation",
      "default_tier": "artifact_ref",
      "trust_class": "canonical"
    }
  },
  "canonical_models": {
    "provenance": {
      "required": ["uri", "sha256", "kind", "created_at", "trust_class"],
      "optional": ["note", "labels"]
    },
    "context_item": {
      "required": ["id", "content", "tier", "trust_class"],
      "optional": ["invoke_role", "score", "labels"]
    },
    "context_budget": {
      "required": ["max_tokens", "used_tokens"],
      "optional": []
    },
    "context_ledger_entry": {
      "required": ["session_id", "timestamp_utc", "context_hash"],
      "optional": ["note"]
    },
    "working_context": {
      "required": ["items", "budget"],
      "optional": ["compiled_at"]
    },
    "compiled_view": {
      "required": ["view_hash", "working_context"],
      "optional": ["degraded", "target"]
    }
  },
  "invoke_role_semantics": {
    "rule_type": "fixed_role_with_score_bonus",
    "note": "invoke_role is assigned per source kind. anchor items are never evicted.",
    "roles": {
      "none":   {"meaning": "No special role",           "score_bonus": 0.0, "pin_behavior": "unpinned",  "compile_behavior": "include_if_budget_allows", "eviction_priority": 4},
      "hint":   {"meaning": "Advisory context",          "score_bonus": 0.1, "pin_behavior": "unpinned",  "compile_behavior": "include_if_budget_allows", "eviction_priority": 3},
      "bridge": {"meaning": "Cross-component reference", "score_bonus": 0.2, "pin_behavior": "soft_pin",  "compile_behavior": "prefer_include",           "eviction_priority": 2},
      "anchor": {"meaning": "Ground truth, never evict", "score_bonus": 0.3, "pin_behavior": "pinned",    "compile_behavior": "always_include",           "eviction_priority": 1}
    }
  },
  "normalization_policy": {
    "preserve_verbatim_where_possible": true,
    "keep_category_order": ["design_invariants", "provenance_registry", "artifact_manifest", "deviation_log"],
    "unknown_date_token": "UNKNOWN_DATE",
    "canonical_export_dedup": true,
    "whitespace_normalization": "strip_trailing_normalize_crlf_to_lf",
    "case_normalization_for_hashing": false,
    "structural_projection_is_canonical": true
  },
  "collector_pipeline": {
    "steps": ["collect", "normalize", "score", "dedup", "budget", "map", "handoff", "ledger"],
    "source_priority": ["canonical", "distilled", "raw", "symbolic"]
  },
  "scoring_policy": {
    "output_range": "[0, 1]",
    "one_shot_invoke_bonus": true,
    "one_shot_rule_text": "If a context item is the sole relevant item for the current task, its score receives the invoke bonus from its invoke_role.",
    "scoring_family": "weighted_sum_with_fail_closed_gates_v1",
    "function": {
      "kind": "weighted_sum_with_fail_closed_gates_v1",
      "aggregation": "weighted_sum",
      "component_order": ["sim", "recency", "invoke", "trust", "continuity"],
      "equation": "score = sum_i(w_i * x_i), x_i in [0,1], weights normalized by sum, score clamped to [0,1]",
      "weight_normalization": "normalize_by_sum",
      "score_bounds": {"min": 0, "max": 1},
      "admission_rule": "exclude_if_any_gate_fails"
    },
    "weights": {"sim": 0.35, "recency": 0.15, "invoke": 0.20, "trust": 0.20, "continuity": 0.10},
    "components": {
      "sim": {
        "description": "Semantic similarity to current task",
        "preferred_metric": "cosine_similarity",
        "fallback_metric": "keyword_overlap",
        "normalization": "min_max"
      },
      "recency": {
        "description": "Recency decay based on last_modified",
        "function": "exponential_decay(lambda=0.1)",
        "unknown_date_recency": {"mode": "fixed", "value": 0.5, "rationale": "Unknown date treated as medium recency"}
      },
      "invoke": {
        "description": "invoke_role score bonus",
        "mapping": {"none": 0.0, "hint": 0.25, "bridge": 0.5, "anchor": 1.0}
      },
      "trust": {
        "description": "Trust class numeric value",
        "mapping": {"canonical": 1.0, "distilled": 0.75, "raw": 0.5, "symbolic": 0.25},
        "normalization": "direct"
      },
      "continuity": {
        "description": "Session continuity -- items used in prior turns score higher",
        "function": "linear_decay_from_last_use"
      }
    },
    "gate_policy": {
      "mode": "fail_closed",
      "min_similarity": 0.10,
      "min_trust": 0.25,
      "anchor_trust_floor": 0.75,
      "behavior_on_failure": "exclude_from_compiled_view"
    },
    "tie_breakers": ["invoke_role_priority", "recency", "trust_class"]
  },
  "dedup_policy": {
    "compile_time_dedup": true,
    "exact_within_tier": {"enabled": true, "key": "content_hash"},
    "semantic_cross_tier": {"enabled": false, "threshold": 0.95, "action": "keep_higher_fidelity"},
    "fidelity_order": ["canonical", "distilled", "raw", "symbolic"],
    "preserve_rules": ["never_dedup_anchor_items"]
  },
  "budget_policy": {
    "max_tokens": 8000,
    "estimation_method": "character_count_div_4",
    "overflow_strategy": "evict_by_phase",
    "anchor_cap": 2000,
    "tier_priority": ["session", "memory", "artifact_ref", "working"],
    "eviction_strategy": {
      "phase_1": {"description": "Evict working-tier items below score threshold", "order": ["working"],      "action": "evict_lowest_score_first",          "guard": "do_not_evict_anchor"},
      "phase_2": {"description": "Evict artifact_ref items",                       "order": ["artifact_ref"], "action": "evict_lowest_score_first",          "guard": "do_not_evict_anchor"},
      "phase_3": {"description": "Evict memory items",                             "order": ["memory"],       "action": "evict_lowest_score_first",          "guard": "do_not_evict_anchor"},
      "phase_4": {"description": "Truncate non-anchor session items",              "order": ["session"],      "action": "truncate_to_fit",                   "guard": "do_not_evict_anchor"},
      "phase_5": {"description": "Emergency: truncate anchor items -- mark as degraded", "order": ["session", "memory"], "action": "truncate_anchors_mark_degraded", "guard": "none"}
    },
    "failure_condition": {"if_budget_still_exceeded": "emit_degraded_flag_and_proceed_with_partial_context"}
  },
  "mapping_rules": [
    {
      "source": "source_code",
      "match": "*.py OR *.ts OR *.js",
      "to_context_item": {"tier": "memory", "invoke_role": "bridge", "trust_class": "canonical", "labels": ["source_code"]}
    },
    {
      "source": "project_docs",
      "match": "README.md OR CHANGELOG.md",
      "to_context_item": {"tier": "artifact_ref", "invoke_role": "hint", "trust_class": "canonical", "labels": ["project_docs"]}
    }
  ],
  "handoff_policy": {
    "allowed_targets": ["ai_session", "ci_pipeline"],
    "max_context_depth": 3,
    "allow_memory": true,
    "allow_artifact_refs": true,
    "require_provenance": true,
    "redact": ["credentials", "secrets", "api_keys"],
    "deny_patterns": ["*.env", "*.pem", "*.key"],
    "memory_scope_rule": "session_only",
    "enforcement": {
      "prefilter": ["apply_redact_patterns", "check_deny_patterns"],
      "target_compile": ["verify_provenance", "apply_budget"],
      "output": {"view_hash": "sha256_of_compiled_view", "degraded_flag": false}
    }
  },
  "artifact_handle_policy": {
    "signed_handles": true,
    "signing_algorithm": "ed25519",
    "expiry_required": true,
    "default_ttl_seconds": 3600,
    "inline_small_artifacts": {"enabled": true, "max_bytes": 4096},
    "signing_triggers": ["on_compile", "on_handoff"],
    "handle_gap_policy": "reject_unsigned_handles",
    "access_audit_required": true
  },
  "error_policy": {
    "parse_failure":                  {"action": "abort_and_report",                                          "severity": "critical"},
    "provenance_resolution_failure":  {"action": "warn_and_continue_with_degraded_flag",                     "severity": "warning"},
    "source_hash_mismatch":           {"action": "warn_and_continue",                                        "severity": "warning"},
    "dedup_failure":                  {"action": "warn_and_continue",                                        "severity": "warning"},
    "scoring_failure":                {"action": "use_fallback_score_zero",                                   "severity": "error"},
    "budget_compile_failure":         {"action": "emit_degraded_flag_and_truncate",                          "severity": "error"},
    "ledger_commit_failure":          {"action": "warn_and_continue",                                        "severity": "warning"},
    "target_policy_violation":        {"action": "deny_handoff_report_violation_require_operator_review",    "severity": "critical"}
  },
  "ledger_policy": {
    "content_digest_only": true,
    "hash_chain": true,
    "payload_fields": ["session_id", "timestamp_utc", "context_hash", "item_count", "budget_used"],
    "context_hash_formula": "sha256(project.version + sorted(provenance.sha256) + generated_at_utc)",
    "audit_chain": ["context_hash", "prior_entry_hash", "timestamp_utc"]
  },
  "cache_policy": {
    "key_formula": "sha256(query_embedding + provenance_hashes + budget_max_tokens)",
    "fail_safe": "recompile_on_cache_miss",
    "note": "Cache is advisory only. A cache miss is not an error."
  },
  "schema_migration": {
    "versioning": "semver",
    "compatibility_rules": {
      "patch": "additive-only field additions, no removal, no semantic change",
      "minor": "new optional fields, deprecations, non-breaking semantic clarifications",
      "major": "breaking field changes, removal, scoring model changes"
    },
    "migration_strategy": [
      "validate existing archive against new schema",
      "apply additive fields with defaults",
      "run self_test_policy checks post-migration",
      "update mica_schema_version"
    ],
    "reproducibility_gate": {"required_match_rate": 1.0, "sample_scope": "all_required_fields"}
  },
  "observability": {
    "metrics": ["context_compile_ms", "budget_utilization", "degraded_rate", "handoff_leak_count", "audit_chain_integrity"],
    "slo_hints": {
      "p95_context_compile_ms": 200,
      "p99_context_compile_ms": 500,
      "budget_failure_rate_max": 0.01,
      "degraded_rate_warn": 0.05,
      "degraded_rate_critical": 0.15,
      "handoff_leak_target": 0,
      "audit_link_integrity_target": 1.0
    }
  },
  "acceptance_criteria": [
    "All required fields present and schema-valid",
    "self_test_policy checks pass on session_start",
    "provenance_registry covers all canonical files"
  ],
  "non_goals": [
    "Runtime enforcement of expression predicates without external validator",
    "Automated provenance_registry updates"
  ],
  "artifact_manifest": {
    "generated_at_utc": "2026-01-01T00:00:00Z",
    "root": ".",
    "entries": [
      {
        "role": "primary_protocol",
        "path": "README.md",
        "sha256": "a665a45920422f9d417e4867efdc4fb8a04a1f3fff1fa07e998e86f7f7a27ae3",
        "required": true,
        "produced_by_stage": "S1"
      }
    ]
  },
  "deviation_log": [],
  "prompt_safety_profile": {
    "profile_name": "universal_operational_archive",
    "allowed_scope": ["maintenance", "operations", "documentation"],
    "blocked_claim_types": ["efficacy_claims", "safety_claims", "regulatory_claims"],
    "enforcement_mode": "warn_and_redact",
    "redact_patterns": ["clinical trial", "FDA", "efficacy"]
  },
  "semantic_validation_policy": {
    "engine": "application_validator",
    "json_schema_limits_note": "Cross-field ordering constraints (p95 <= p99, degraded_rate_warn < degraded_rate_critical) cannot be enforced by JSON Schema alone.",
    "rules": [
      {
        "id": "SV-001",
        "expression": "$.observability.slo_hints.p95_context_compile_ms <= $.observability.slo_hints.p99_context_compile_ms",
        "severity": "error",
        "on_fail": "reject_archive"
      },
      {
        "id": "SV-002",
        "expression": "$.observability.slo_hints.degraded_rate_warn < $.observability.slo_hints.degraded_rate_critical",
        "severity": "error",
        "on_fail": "reject_archive"
      }
    ]
  },
  "self_consistency_policy": {
    "mode": "fail_closed",
    "algorithm": "sha256_hash_chain_with_field_equality",
    "version_source": "explicit_archive_header",
    "required_equalities": ["mica_schema_version must match schema $id version component"],
    "doc_sanity_checks": [
      {
        "id": "SC-001",
        "expression": "exists($.project.name) and len($.project.name) > 0",
        "severity": "error",
        "on_fail": "reject_archive_and_require_sync_patch"
      },
      {
        "id": "SC-002",
        "expression": "len($.design_invariants) > 0",
        "severity": "warning",
        "on_fail": "warn_operator"
      }
    ],
    "behavior_on_failure": "reject_archive_and_require_sync_patch"
  },
  "operation_meta": {
    "archive_id": "MICA-EXAMPLE-SERVICE-001",
    "baseline_ref": "v1.0.0-2026-01-01",
    "objective": "Minimum viable MICA archive demonstrating all required fields for v0.1.8.1 validation.",
    "operating_mode": "maintain",
    "current_state": "active",
    "update_count": 0,
    "domain_status": {
      "identity": "stable",
      "content": "stable",
      "operations": "stable",
      "growth": "pending"
    },
    "invocation_notes": "Primary invocation via README [AI Session Protocol]. AI session is the self-test runtime."
  }
}
