{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flamehaven/mica/mica.sessions.schema.json",
  "title": "MICA v0.2.9 Session Record",
  "description": "Schema for one session envelope record in mica.sessions.jsonl. Each line in the stream must validate independently.",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "opened_at_utc",
    "closed_at_utc",
    "project_scope",
    "actors",
    "source",
    "session_hash"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "mica.sessions.v1"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "opened_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "closed_at_utc": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "project_scope": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["actor_id", "actor_type"],
        "additionalProperties": false,
        "properties": {
          "actor_id": {
            "type": "string",
            "minLength": 1
          },
          "actor_type": {
            "type": "string",
            "enum": ["agent", "human", "system", "adapter"]
          },
          "role": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["system"],
      "additionalProperties": false,
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1
        },
        "tool_name": {
          "type": "string",
          "minLength": 1
        },
        "repo_root": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "session_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "prev_session_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
