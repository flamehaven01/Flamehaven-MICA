{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flamehaven/mica/mica.invocation.schema.json",
  "title": "MICA Invocation Trace Record (v1 and v2)",
  "description": "Schema for one invocation provenance record in mica.invocation.jsonl. Each line must validate independently. v2 adds digest-bound continuity fields (trigger, surface_evidence, capsule_hash); v1 records remain valid historical artifacts and are never rewritten.",
  "type": "object",
  "required": [
    "schema_version",
    "invocation_id",
    "timestamp_utc",
    "project_root",
    "project",
    "package_state",
    "core_state",
    "flow_state",
    "mode",
    "pattern",
    "session_id",
    "invocation_contract",
    "loaded_surfaces",
    "agent_context_surfaces",
    "deferred_surfaces",
    "missing_invoked_surfaces",
    "active_critical_invariants",
    "last_updated"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "mica.invocation.v1",
        "mica.invocation.v2"
      ]
    },
    "invocation_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "project_root": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "package_state": {
      "type": "string",
      "enum": [
        "INVOCATION_MODE",
        "LEGACY_MODE",
        "INACTIVE"
      ]
    },
    "core_state": {
      "type": "string",
      "enum": [
        "CLOSED",
        "INCOMPLETE",
        "LEGACY",
        "INACTIVE"
      ]
    },
    "flow_state": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "FLOW_OFFLINE",
        "FLOW_ENABLED",
        "FLOW_DEGRADED",
        null
      ]
    },
    "mode": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "memory_injection",
        "protocol_evolution",
        "memory_first",
        null
      ]
    },
    "pattern": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "readme_protocol",
        "hook_trigger",
        "agent_yaml_bootstrap",
        "global_skill",
        "workspace_directive",
        "explicit",
        "legacy",
        null
      ]
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "invocation_contract": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "memory_first",
        "archive_first",
        "legacy_archive",
        null
      ]
    },
    "loaded_surfaces": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "agent_context_surfaces": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "operator_only_surfaces": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "deferred_surfaces": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "missing_invoked_surfaces": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "active_critical_invariants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "last_updated": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "trigger": {
      "type": [
        "object",
        "null"
      ],
      "description": "Consumer-owned lifecycle event that occasioned this invocation. MICA records the reference; it does not execute or authorize the event.",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "surface_evidence": {
      "type": "array",
      "description": "Digest-bound record of the exact bytes resolved for each loaded surface. Evidence proves selection and recording, never comprehension.",
      "items": {
        "type": "object",
        "required": [
          "role",
          "path",
          "sha256",
          "bytes",
          "audience",
          "delivery_state"
        ],
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "description": "Repository-relative, forward-slash normalized.",
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "audience": {
            "type": "string",
            "enum": [
              "agent_context",
              "operator_only",
              "deferred"
            ]
          },
          "delivery_state": {
            "type": "string",
            "enum": [
              "declared",
              "resolved",
              "emitted",
              "acknowledged"
            ],
            "description": "emitted means an adapter reported bytes written to its channel; acknowledged requires an independently supplied host reference. Neither implies read, understood, or obeyed."
          }
        }
      }
    },
    "capsule_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Deterministic hash over trigger, surface evidence, session binding, and invocation state. Excludes itself and the absolute project_root so the same capsule hashes identically across platforms."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "mica.invocation.v2"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "trigger",
          "surface_evidence",
          "capsule_hash"
        ]
      }
    }
  ]
}
