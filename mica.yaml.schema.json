{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flamehaven/mica/mica.yaml.schema.json",
  "title": "MICA Composition Contract",
  "description": "Schema for mica.yaml. Declares what files constitute a MICA package and how it is invoked. v0.2.4: hookOutputPolicy added. v0.2.6: di_policy added. v0.2.7: di_policy.namespace_mode added. v0.2.8: di_policy.max_archive_age_days added.",
  "type": "object",
  "required": ["mica_spec", "mode", "layers"],
  "additionalProperties": false,
  "properties": {
    "mica_spec": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "examples": ["0.2.8", "0.2.7", "0.2.6"]
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "examples": ["flamehaven-super-saver"]
    },
    "mode": {
      "type": "string",
      "enum": ["memory_injection", "protocol_evolution"]
    },
    "description": {
      "type": "string",
      "maxLength": 300
    },
    "layers": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/layer" },
      "allOf": [
        {
          "contains": {
            "required": ["name", "path", "format"],
            "properties": {
              "name": { "const": "archive" },
              "format": { "const": "json" }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "required": ["name", "path", "format"],
            "properties": {
              "name": { "const": "playbook" },
              "format": { "const": "markdown" }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "invocation_protocol": {
      "$ref": "#/$defs/invocationProtocol"
    },
    "update_triggers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "on_maintenance_complete",
          "on_dogfood_cycle_close",
          "on_explicit_save",
          "on_version_bump",
          "on_hook_trigger"
        ]
      }
    },
    "di_policy": {
      "$ref": "#/$defs/diPolicy"
    },
    "archive_policy": {
      "$ref": "#/$defs/archivePolicy"
    },
    "drift_profile": {
      "$ref": "#/$defs/driftProfile"
    }
  },
  "$defs": {
    "layer": {
      "type": "object",
      "required": ["name", "path", "format"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "path": {
          "type": "string",
          "description": "Path relative to project root. Use forward slashes."
        },
        "format": {
          "type": "string",
          "enum": ["json", "markdown"]
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "max_lines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "loading_hint": {
          "type": "string",
          "enum": ["always", "on_demand", "session_start_only", "hook"]
        }
      }
    },
    "hookOutputPolicy": {
      "type": "object",
      "description": "Controls hook-format DI output volume (v0.2.4). Omit to preserve v0.2.3 behavior: all DIs emitted, unlimited lines.",
      "additionalProperties": false,
      "properties": {
        "max_di_lines": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum number of [MICA:DI] lines to emit. 0 or omitted means unlimited."
        },
        "di_filter": {
          "type": "string",
          "enum": ["all", "violations_only"],
          "default": "all",
          "description": "violations_only: suppress DIs where violation_count is absent or 0."
        }
      }
    },
    "invocationProtocol": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary_pattern": {
          "type": "string",
          "enum": ["readme_protocol", "hook_trigger", "agent_yaml_bootstrap", "global_skill", "workspace_directive", "explicit"]
        },
        "hook_script": {
          "type": "string"
        },
        "hook_output_prefix": {
          "type": "string"
        },
        "hook_output": {
          "$ref": "#/$defs/hookOutputPolicy"
        }
      }
    },
    "diPolicy": {
      "type": "object",
      "description": "Binding enforcement and namespace policy for design invariants. v0.2.6: critical_binding_required. v0.2.7: namespace_mode. v0.2.8: max_archive_age_days.",
      "additionalProperties": false,
      "properties": {
        "critical_binding_required": {
          "type": "boolean",
          "default": false,
          "description": "When true, PCT-010 escalates to FAIL if any critical DI lacks binding.origin_episode. Default false preserves v0.2.5 WARN behavior."
        },
        "namespace_mode": {
          "type": "string",
          "enum": ["sequential", "domain_namespaced", "legacy_inv"],
          "default": "sequential",
          "description": "DI ID namespace convention for this archive. sequential: canonical DI-NNN. domain_namespaced: DI-[DOMAIN]-NNN for multi-lane systems (e.g. DI-EQA-001). legacy_inv: INV-NNN grandfathered prefix. All modes validated by mica-v0.2.7-archive-di-binding.schema.json pattern ^(DI|INV)(-[A-Z][A-Z0-9]*)?-\\d+$."
        },
        "max_archive_age_days": {
          "type": "integer",
          "minimum": 1,
          "description": "v0.2.8 opt-in. When set, PCT-012 WARNs if operation_meta.last_updated in the archive is older than this many days. Absent means PCT-012 reports INFO (check not configured). Suggested values: 90 (active projects), 180 (maintenance mode), 365 (stable packages)."
        }
      }
    },
    "archivePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rotation": {
          "type": "string",
          "enum": ["on_version_bump", "monthly", "quarterly"]
        },
        "retention": {
          "type": "string",
          "pattern": "^(indefinite|\\d+[dmy])$"
        }
      }
    },
    "diBinding": {
      "type": "object",
      "description": "Evidence block for mica.yaml drift_profile.classes DIs. For archive design_invariants, use mica-v0.2.7-archive-di-binding.schema.json.",
      "required": ["origin_episode"],
      "additionalProperties": false,
      "properties": {
        "origin_episode": {
          "type": "string",
          "minLength": 10,
          "description": "Human-readable description of the event that motivated this invariant."
        },
        "violation_count": {
          "type": "integer",
          "minimum": 0
        },
        "lesson_ref": {
          "type": "string"
        },
        "last_triggered": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "driftClass": {
      "type": "object",
      "required": ["id", "label", "severity", "action"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3}$"
        },
        "label": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "severity": {
          "type": "string",
          "enum": ["warning", "error", "critical"]
        },
        "action": {
          "type": "string",
          "enum": ["block_session", "require_acknowledgment", "warn_continue", "log_only"]
        },
        "binding": {
          "$ref": "#/$defs/diBinding"
        }
      }
    },
    "driftProfile": {
      "type": "object",
      "required": ["enabled", "source_classes", "classes"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "default_action": {
          "type": "string",
          "enum": ["block_session", "require_acknowledgment", "warn_continue", "log_only"]
        },
        "source_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/driftClass" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "mode": { "const": "protocol_evolution" } },
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "layers": {
            "contains": {
              "properties": { "name": { "const": "lessons" } },
              "required": ["name"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "invocation_protocol": {
            "properties": { "primary_pattern": { "const": "hook_trigger" } },
            "required": ["primary_pattern"]
          }
        }
      },
      "then": {
        "properties": {
          "invocation_protocol": {
            "required": ["primary_pattern", "hook_script"]
          }
        }
      }
    }
  ]
}
