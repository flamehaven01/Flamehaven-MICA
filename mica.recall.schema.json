{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flamehaven/mica/mica.recall.schema.json",
  "title": "MICA v0.2.9 Recall Trace Record",
  "description": "Schema for one append-only recall trace record in mica.recall.jsonl.",
  "type": "object",
  "required": [
    "schema_version",
    "recall_id",
    "timestamp_utc",
    "session_id",
    "target",
    "candidate_id"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "mica.recall.v1"
    },
    "recall_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "target": {
      "type": "string",
      "enum": ["operator_review", "agent_context"]
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "source_event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._:-]*$"
      },
      "uniqueItems": true
    },
    "reason": {
      "type": "string",
      "maxLength": 2000
    }
  }
}
