{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flamehaven/mica/mica.graph.schema.json",
  "title": "MICA v0.2.9 Graph Edge Record",
  "description": "Schema for one relation edge in mica.graph.jsonl. Each line in the stream must validate independently.",
  "type": "object",
  "required": [
    "schema_version",
    "edge_id",
    "from_ref",
    "to_ref",
    "relation",
    "created_at_utc",
    "source_event_ids"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "mica.graph.v1"
    },
    "edge_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "from_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "to_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "relation": {
      "type": "string",
      "enum": [
        "supports",
        "contradicts",
        "supersedes",
        "depends_on",
        "belongs_to_session",
        "exported_as"
      ]
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "source_event_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._:-]*$"
      },
      "uniqueItems": true
    },
    "weight": {
      "type": "number",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": ["active", "retracted"],
      "default": "active"
    }
  }
}
